# Supabase (프로젝트 생성 후 Settings > API 에서 복사)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# 서버 전용(관리 작업/시트·이코딩 가져오기 스크립트에서만 사용, 절대 클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# 카카오 채널
NEXT_PUBLIC_KAKAO_CHANNEL_URL=https://pf.kakao.com/_ZxnMxdn/chat
# 이코딩 결제/출결(링크 방식)
NEXT_PUBLIC_ECODING_ADMIN_URL=https://ts.edu-coding.co.kr/admin

# 서비스 도메인 (가비아에서 구매, 배포 시 Vercel 연결)
NEXT_PUBLIC_SITE_URL=https://amyschool.kr
NEXT_PUBLIC_ECODING_URL=https://edu-coding.co.kr
